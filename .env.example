# ----------------------------------------------------------------- the teacher
# Swapping providers is a base-URL + model change, nothing else.
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Disk cache for teacher responses. Set to 0 to disable.
LLM_CACHE=1

# ------------------------------------------------------------------- the server
# The pages allowed to call this API from another origin. Only consulted when the
# page is served from somewhere else: the Vite dev server proxies /api, and one
# process serving both is same-origin. With the page on Vercel, this is its
# address (https://teaching-ide.vercel.app). Comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How the API checks who is signed in. Leave both blank and it serves every call
# anonymously, exactly as it did before auth existed. Set either and a presented
# token must verify.
#
# The project URL, the same value as VITE_SUPABASE_URL below. Tokens are checked
# against the project's public signing keys (ES256/RS256), which is how new
# projects sign. Nothing secret. Not read from VITE_SUPABASE_URL on purpose: see
# server/auth.py.
SUPABASE_URL=
# Only for a project still signing with the legacy HS256 secret (Supabase →
# Project Settings → JWT Keys → Legacy JWT Secret). Both may be set mid-rotation.
SUPABASE_JWT_SECRET=

# --------------------------------------------------------- auth and persistence
# Supabase → Project Settings → API. Both are safe in the browser; the anon key
# is public by design and row-level security is what protects the data.
# Leave both blank to run signed-out: no sign-in bar, no saved progress, no
# recorded sessions. The lesson itself is unaffected.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------- where the API is
# Blank: the page calls /api on its own origin (Vite's proxy in development, or
# one process serving both). With the page hosted apart from the API, the API's
# address, no trailing slash: https://teaching-ide-api.onrender.com. Read by the
# browser at BUILD time, so set it where the page is built (Vercel), and list
# the page's address in that API's ALLOWED_ORIGINS.
VITE_API_URL=

# ------------------------------------------------------------ voice questions
# The mic button records in the browser; this server turns the clip into text with
# the same provider and key as the teacher, and the text lands in the ask box for
# the learner to check. The audio is not stored or logged. On Groq's free plan
# Whisper allows 20 requests a minute and 2,000 a day for the whole key, so the
# per-caller limits below are far lower. A provider with no audio endpoint:
# STT_MODEL=none, and the mic says voice is unavailable instead of failing.
STT_MODEL=whisper-large-v3-turbo
# Blank detects the language; short clips detect badly, so set it (en, es, ...) if
# every learner speaks one.
STT_LANGUAGE=
STT_PER_MINUTE=6
STT_PER_DAY=150

# ------------------------------------------------------------ the teacher's voice
# The speaker in the top bar reads the teacher aloud with ElevenLabs, through this
# server. Blank: every learner hears the browser's own voice instead, which is
# also what they hear whenever ElevenLabs cannot be had (credits used up, the key
# refused, a limit below hit). Only learners who turned the speaker on spend
# anything, and words already spoken are replayed from memory for free.
ELEVENLABS_API_KEY=
# George, a stock voice. Any voice in your library: its id is on its page.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# The cheapest and fastest. eleven_multilingual_v2 sounds better, costs double.
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_FORMAT=mp3_44100_64
# Per caller, and characters a day for the whole key.
TTS_PER_MINUTE=12
TTS_PER_DAY=300
TTS_CHARS_PER_DAY=20000

# ------------------------------------------------------------ limits (the API)
# Per caller (the signed-in user, otherwise the address) and in memory, so they
# apply per process. A refused call is never an error the learner sees: they get
# the hand-written hint instead.
TEACH_PER_MINUTE=10
TEACH_PER_DAY=400
# Observer-triggered interruptions per sitting. Matches the observer's default.
TEACH_GATE_BUDGET=8
# Set to 1 ONLY behind a reverse proxy you control; otherwise callers could
# spoof their own address and sidestep the rate limits.
TRUST_PROXY=0

# --------------------------------------------------------------- the deployment
# The interactive API docs describe every endpoint to anyone who asks.
ENABLE_DOCS=0
# Port the container listens on.
PORT=8000
