{
  "name": "teaching-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "start": "npm run build && .venv/bin/python -m uvicorn server.main:app --port 8000",
    "api": ".venv/bin/python -m uvicorn server.main:app --reload --reload-dir server --port 8000",
    "verify-supabase": "node scripts/verify-supabase.mjs",
    "validate-tools": ".venv/bin/python -m server.validate_tools",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@supabase/supabase-js": "^2.117.2",
    "acorn": "^8.19.0",
    "codemirror": "^6.0.1",
    "comlink": "^4.4.2",
    "pyodide": "0.27.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "3.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
